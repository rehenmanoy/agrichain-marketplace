PORT=5000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ft_db
# Separate database used by `npm test` (it gets wiped and re-seeded on every run)
TEST_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ft_db_test

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
# A token lasts 1 hour; the app renews it while the user is active
JWT_EXPIRES_IN=1h
# One login can never be extended past this many hours, however active the user is
SESSION_MAX_HOURS=12

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Daily market price fetch (24-hour time). Set PRICE_FETCH_ENABLED=false to turn it off.
PRICE_FETCH_TIME=06:00
PRICE_FETCH_TIMEZONE=Asia/Kolkata
PRICE_FETCH_ENABLED=true

# Where uploaded warehouse photos are saved (default: backendft/uploads)
# UPLOAD_DIR=./uploads

# The forgot-password code is also shown on screen until an SMS provider is connected (on by default except in production)
# RESET_CODE_IN_RESPONSE=true
